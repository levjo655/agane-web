generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Knife {
  id String @id @default(uuid())

  slug String @unique

  title String
  maker String

  origin String?
  steel  String?
  length String?
  handle String?
  weight Int?

  description String

  price Int

  images String[]

  status String @default("available")

  createdAt DateTime @default(now())
}
