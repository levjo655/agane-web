generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Maker {

  id String @id @default(uuid())

  name String

  slug String @unique

  country String?

  bio String?

  image String?

  website String?

  instagram String?

  knives Knife[]

  collaborations Collaboration[]

  createdAt DateTime @default(now())

}


model Knife {

  id String @id @default(uuid())

  title String

  slug String @unique

  makerId String?

  maker Maker? @relation(
    fields: [makerId],
    references: [id]
  )

  origin String?

  steel String?

  bladeType String?

  length String?

  handle String?

  weight Float?

  price Int

  description String?

  images Json

  status String @default("available")

  order Order?

  createdAt DateTime @default(now())

}


model Collaboration {

  id String @id @default(uuid())

  makerId String?

  maker Maker? @relation(
    fields: [makerId],
    references: [id]
  )

  title String

  description String?

  quantity Int

  status String @default("upcoming")

  releaseDate DateTime?

  image String?

  createdAt DateTime @default(now())

}


model Order {

  id String @id @default(uuid())

  knifeId String @unique

  knife Knife @relation(
    fields: [knifeId],
    references: [id]
  )

  stripeSessionId String @unique

  customerEmail String?

  customerName String?

  amount Int

  currency String @default("sek")

  status String @default("pending")

  createdAt DateTime @default(now())

}