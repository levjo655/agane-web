generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ==================================================
// MAKER
// ==================================================

model Maker {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  country        String?
  bio            String?
  image          String?
  website        String?
  instagram      String?
  createdAt      DateTime        @default(now())

  collaborations Collaboration[]
  knives         Knife[]
}


// ==================================================
// KNIFE
// ==================================================

model Knife {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  origin      String?
  steel       String?
  bladeType   String?
  length      String?
  handle      String?
  weight      Float?
  price       Int
  description String?
  images      Json
  createdAt   DateTime @default(now())
  status      String   @default("available")

  makerId     String?
  maker       Maker?   @relation(fields: [makerId], references: [id])

  order       Order?
}


// ==================================================
// SHARPENING SUPPLY
// ==================================================

model SharpeningSupply {
  id String @id @default(uuid())

  title String
  slug  String @unique

  category    String
  description String?

  price Int

  stock Int @default(1)

  images Json

  status String @default("available")

  orders Order[]

  createdAt DateTime @default(now())
}


// ==================================================
// ORDER
// ==================================================

model Order {
  id String @id @default(uuid())

  // ------------------------------------------
  // KNIFE
  // ------------------------------------------

  knifeId String? @unique

  knife Knife? @relation(
    fields: [knifeId],
    references: [id]
  )


  // ------------------------------------------
  // SHARPENING SUPPLY
  // ------------------------------------------

  sharpeningSupplyId String?

  sharpeningSupply SharpeningSupply? @relation(
    fields: [sharpeningSupplyId],
    references: [id]
  )


  // ------------------------------------------
  // QUANTITY
  // ------------------------------------------

  quantity Int @default(1)


  // ------------------------------------------
  // STRIPE
  // ------------------------------------------

  stripeSessionId String @unique


  // ------------------------------------------
  // CUSTOMER
  // ------------------------------------------

  customerEmail String?
  customerName  String?


  // ------------------------------------------
  // PAYMENT
  // ------------------------------------------

  amount   Int
  currency String @default("sek")
  status   String @default("pending")


  // ------------------------------------------
  // TIMESTAMP
  // ------------------------------------------

  createdAt DateTime @default(now())
}