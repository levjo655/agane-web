generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Knife {

  id String @id @default(uuid())

  title String

  slug String @unique

  maker String

  origin String?

  steel String?

  bladeType String?

  length String?

  handle String?

  weight Float?

  price Int

  description String?

  images Json

  createdAt DateTime @default(now())

}