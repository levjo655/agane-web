generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Knife {

  id String @id @default(uuid())

  title String

  slug String @unique

  maker String

  origin String?

  steel String?

  bladeType String?

  length String?

  handle String?

  weight Float?

  price Int

  description String?

  images Json

  status String @default("available")

  createdAt DateTime @default(now())

}
model Collaboration {
  id String @id @default(uuid())

  maker String

  title String

  description String?

  quantity Int

  status String @default("upcoming")

  releaseDate DateTime?

  image String?

  createdAt DateTime @default(now())
}
